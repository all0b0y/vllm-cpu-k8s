# Top-level runtime dependencies of the vLLM image (input for the lock).
# Lock: docker/vllm/requirements.txt  (generated by `make lock`, never edit by hand).
# Official vLLM CPU wheels from the GitHub release, one per CPU architecture.
vllm @ https://github.com/vllm-project/vllm/releases/download/v0.31.0/vllm-0.31.0+cpu-cp38-abi3-manylinux_2_39_aarch64.whl ; sys_platform == 'linux' and platform_machine == 'aarch64'
vllm @ https://github.com/vllm-project/vllm/releases/download/v0.31.0/vllm-0.31.0+cpu-cp38-abi3-manylinux_2_39_x86_64.whl ; sys_platform == 'linux' and platform_machine == 'x86_64'
